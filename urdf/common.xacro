<?xml version="1.0"?>
<robot name="rbvogui_common" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
  Common xacro file for the RB-VOGUI robot with 4 steerable wheels.
  THIS FILE IS NOT A COMPLETE ROBOT MODEL, IT IS MEANT TO BE INCLUDED IN THE SPECIFIC ROBOT MODEL
  XACRO FILES (FOR EXAMPLE, MODEL_BASE.XACRO AND MODEL_FORKLIFT.XACRO).

  The base is composed of the RB-VOGUI chassis, battery and four steerable wheels:
  - Front-left wheel uses angle +alpha.
    (x_0 = d*cos(+alpha), y_0 = d*sin(+alpha))
  - Front-right wheel uses angle -alpha.
    (x_0, -y_0)
  - Rear-left wheel uses angle 180 - alpha.
    (-x_0, y_0)
  - Rear-right wheel uses angle -180 + alpha.
    (-x_0, -y_0)
  Reference: package://ground_vehicle_kinematics/doc/kinematics_en.pdf

  - The chassis uses the RB-VOGUI DAE mesh for visual and the matching STL mesh for collision.
  - Dynamics are intentionally simplified.

  Battery:
  The battery uses the RB-VOGUI battery STL mesh for visual and collision.
  It is always present in this model and keeps the center of mass low.
  The base, chassis and battery links follow the RB-VOGUI frame layout.
  -->

  <!-- ===================================================================== -->
  <!-- INCLUDES -->
  <!-- ===================================================================== -->

  <xacro:include filename="$(find robotics_description)/urdf/common/all_commons.xacro"/>
  <xacro:include filename="$(find robotics_description)/urdf/wheels/all_wheels.xacro"/>
  <xacro:include filename="$(find robotics_description)/urdf/wheels/generic_macros/all_wheels_plugins.xacro"/>
  <xacro:include filename="$(find robotics_description)/urdf/gz_system_plugins/all_gz_system_plugins.xacro"/>

  <!-- ===================================================================== -->
  <!-- ARGS -->
  <!-- ===================================================================== -->
  <xacro:arg name="namespace"    default=""/>
  <xacro:arg name="robot_name"   default="rbvogui"/>
  <!--
  File containing the simulation configuration for the selected robot model.
  If it is empty, no simulation YAML is loaded from this file.
  -->
  <xacro:arg name="sim_file" default=""/>

  <xacro:arg name="body_color"             default="0.5 0.5 0.5 1.0"/>
  <xacro:arg name="body_use_visual"        default="True"/>
  <xacro:arg name="body_use_collision"     default="True"/>
  <xacro:arg name="body_use_inertial"      default="True"/>
  <xacro:arg name="s_wheel_use_visual"     default="True"/>
  <xacro:arg name="s_wheel_use_v_mesh"     default="True"/>
  <xacro:arg name="s_wheel_color"          default="0.1 0.1 0.1 1.0"/>
  <xacro:arg name="s_wheel_use_inertial"   default="True"/>

  <!--
  To let a wheel reach +/-pi radians (+/-180 degrees), set the limits to
  +-3.1416 (slightly above pi).
  -->
  <xacro:arg name="s_wheel_steering_joint_limits" default="-3.1416 3.1416 100.0 100000.0"/>
  <xacro:arg name="s_wheel_rotation_joint_limits" default="100.0 100000.0"/>

  <!-- ===================================================================== -->
  <!-- DEFINITION OF PROPERTIES -->
  <!-- ===================================================================== -->

  <!-- Create properties from args for easy manipulation. -->

  <xacro:property name="namespace"    value="$(arg namespace)"/>
  <xacro:property name="robot_name"   value="$(arg robot_name)"/>

  <!-- Set the property 'robot_namespace' -->
  <xacro:make_namespace prop_id="robot_namespace" namespace="${namespace}" name="${robot_name}"/>

  <!-- Set the property 'robot_prefix' -->
  <xacro:make_prefix prop_id="robot_prefix" name="${robot_name}"/>

  <!-- An empty or whitespace-only path selects the real-robot description. -->
  <xacro:property name="sim_file_raw" value="$(arg sim_file)"/>
  <xacro:property name="sim_file"     value="${str(sim_file_raw).strip()}"/>
  <xacro:property name="sim_cfg"
                  value="${xacro.load_yaml(sim_file) if sim_file != '' else dict()}"/>

  <!--
  The body geometry is fixed in this common file and follows the RB-VOGUI body meshes.
  `body_color` is still validated for launch-interface compatibility, but the chassis DAE keeps
  its embedded material. The battery STL has no reliable material, so this model sets its color
  explicitly below.
  -->
  <xacro:property name="body_color"        value="$(arg body_color)"/>
  <xacro:property name="body_color_values" value="${body_color.split()}"/>

  <xacro:if value="${len(body_color_values) != 4}">
    ${xacro.fatal("xacro arg body_color must contain exactly 4 values: r g b a")}
  </xacro:if>

  <xacro:property name="body_use_visual"    value="$(arg body_use_visual)"/>
  <xacro:property name="body_use_collision" value="$(arg body_use_collision)"/>
  <xacro:property name="body_use_inertial"  value="$(arg body_use_inertial)"/>
  <xacro:property name="top_body_size_x"        value="1.044"/>
  <xacro:property name="top_body_size_y"        value="0.650"/>
  <xacro:property name="top_body_size_z"        value="0.235"/>
  <xacro:property name="top_body_mass"          value="25.0"/>
  <xacro:property name="bottom_body_size_x"     value="0.483037"/>
  <xacro:property name="bottom_body_size_y"     value="0.420000"/>
  <xacro:property name="bottom_body_size_z"     value="0.105000"/>
  <xacro:property name="bottom_body_mass"       value="45"/>
  <xacro:property name="ground_clearance"       value="0.1165"/>
  <xacro:property name="dist_to_wheels"         value="0.4366337137693332"/>
  <xacro:property name="alpha_deg"              value="32.56180140948635"/>
  <xacro:property name="chassis_joint_origin"   value="-0.012 0 0.1775 0 0 0"/>
  <xacro:property name="battery_joint_origin"   value="0.02952 0 0 0 0 0"/>
  <xacro:property name="body_mesh_scale"        value="1.0 1.0 1.0"/>
  <xacro:property name="chassis_visual_mesh"    value="robot_rbvogui_common/meshes/rbvogui_chassis.dae"/>
  <xacro:property name="chassis_collision_mesh" value="robot_rbvogui_common/meshes/rbvogui_chassis.stl"/>
  <xacro:property name="battery_mesh"           value="robot_rbvogui_common/meshes/rbvogui_battery.stl"/>
  <xacro:property name="battery_color"
                  value="${robot_prefix}battery_color 0.08235 0.08235 0.08235 1.0"/>

  <xacro:property name="s_wheel_use_visual"   value="$(arg s_wheel_use_visual)"/>
  <xacro:property name="s_wheel_use_v_mesh"   value="$(arg s_wheel_use_v_mesh)"/>
  <xacro:property name="s_wheel_color"        value="$(arg s_wheel_color)"/>
  <xacro:property name="s_wheel_color_values" value="${s_wheel_color.split()}"/>

  <xacro:if value="${s_wheel_color != '' and len(s_wheel_color_values) != 4}">
    ${xacro.fatal("xacro arg s_wheel_color must contain exactly 4 values: r g b a")}
  </xacro:if>

  <xacro:property name="s_wheel_use_inertial" value="$(arg s_wheel_use_inertial)"/>

  <!--
  For prismatic joints, setting the rest position exactly at a limit can cause lock-up because of
  numerical precision during initialization. The simulator may spawn the joint slightly outside the
  valid range.
  Example: if the lower limit is 0 and the rest position is set to 0, the initialized value might
  be a tiny negative number (for example, -1.9e-12). Even this small violation can block motion.
  Effort controllers are not affected.
  To avoid this issue when the rest position is at the lower bound, set 'lower_limit' slightly below
  the intended physical bound. The same applies to the upper bound: if the rest position is at the
  upper limit, set 'upper_limit' slightly above the intended value.
  The required margin is very small, so the practical effect on behavior is negligible.
  If the rest position is not at either limit (for example, near the middle of the range), no extra
  margin is usually needed.
  -->

  <xacro:property name="s_wheel_steering_joint_limits"
                  value="$(arg s_wheel_steering_joint_limits)"/>

  <xacro:property name="s_wheel_steering_joint_limits_values"
                  value="${s_wheel_steering_joint_limits.split()}"/>

  <xacro:if value="${len(s_wheel_steering_joint_limits_values) != 4}">
    ${xacro.fatal(
    "xacro arg s_wheel_steering_joint_limits must contain exactly 4 values: "
    "lower_limit upper_limit velocity effort"
    )}
  </xacro:if>

  <xacro:property name="s_wheel_rotation_joint_limits"
                  value="$(arg s_wheel_rotation_joint_limits)"/>

  <xacro:property name="s_wheel_rotation_joint_limits_values"
                  value="${s_wheel_rotation_joint_limits.split()}"/>

  <xacro:if value="${len(s_wheel_rotation_joint_limits_values) != 2}">
    ${xacro.fatal(
    "xacro arg s_wheel_rotation_joint_limits must contain exactly 2 values: "
    "velocity effort"
    )}
  </xacro:if>

  <!--
  Important:
  The `gz::sim::systems::VelocityControl` plugin applies chassis motion directly. The wheel-joint
  controllers animate the wheels but wheel-ground forces do not drive the chassis. Consequently,
  the contact parameters (`mu`, `mu2`, `slip1` and `slip2`) are not used to reproduce drivetrain
  dynamics; they are configured with low values to minimize unwanted resistance.
  The velocity and effort limits for the steering and rotation joints are intentionally high so
  that they approximate ideal joints.
  This prevents the joint limits from interfering when the robot is controlled in velocity mode.
  Read the macro 'steerable_wheel_macro.xacro' for more details about these limit parameters.
  -->


  <!--
  The wheel mesh frame must be centered at its geometric center and oriented with Z+ as the
  symmetry axis. With the wheel lying on the ground, Z+ is vertical, X+ points forward and Y+
  points left.
  The wheel mesh path is fixed in this common file.
  `s_wheel_use_visual` controls whether the wheel has a visual element. When enabled,
  `s_wheel_use_v_mesh` selects the built-in mesh or the primitive cylinder.
  When the built-in mesh is used, the mesh must follow the convention described below.
  The macro of the steerable wheel will rotate that geometry +90 degrees around the x-axis.
  Wheel collisions always use the primitive cylinder defined by the `steerable_wheel` macro;
  this model does not expose collision-geometry options.
  Read the steerable_wheel macro for more details.
  -->
  <xacro:property name="s_wheel_mesh"
                  value="${'robotics_description/meshes/wheels/standard_wheels/rubber_wheel_2.stl' if s_wheel_use_v_mesh else ''}"/>
  <xacro:property name="s_wheel_mesh_scale"          value="1.0 1.0 1.0"/>
  <!-- Keep this radius identical to the value configured for ground_vehicle_kinematics. -->
  <xacro:property name="s_wheel_radius"              value="0.117494"/>
  <xacro:property name="s_wheel_thickness"           value="0.142462"/>
  <xacro:property name="s_wheel_mass"                value="7.5"/>
  <xacro:property name="s_wheel_steering_joint_type" value="revolute"/>
  <xacro:property name="s_wheel_rotation_joint_type" value="continuous"/>

  <!-- Names for components -->
  <xacro:property name="base_name"              value="base"/>
  <xacro:property name="front_left_wheel_name"  value="front_left_wheel"/>
  <xacro:property name="front_right_wheel_name" value="front_right_wheel"/>
  <xacro:property name="rear_left_wheel_name"   value="rear_left_wheel"/>
  <xacro:property name="rear_right_wheel_name"  value="rear_right_wheel"/>

  <!-- ===================================================================== -->
  <!-- Definition of links and joints for the RB-VOGUI base -->
  <!-- ===================================================================== -->

  <!--
  The link '${base_name}_footprint_link' is located on the ground below '${base_name}_link'.
  The '${base_name}_link' frame is placed at the wheel-center height, as in RB-VOGUI.
  -->
  <link name="${robot_prefix}${base_name}_footprint_link"/>

  <link name="${robot_prefix}${base_name}_link">
    <xacro:null_inertia/>
  </link>

  <joint name="${robot_prefix}${base_name}_footprint_joint" type="fixed">
    <parent link="${robot_prefix}${base_name}_footprint_link"/>
    <child link="${robot_prefix}${base_name}_link"/>
    <!--
    The origin of '${base_name}_footprint_link' is the ground projection of the robot base.
    The origin of '${base_name}_link' is at the wheel-center height.
    The fixed joint has zero rotation, so both frames use the same X, Y and Z axis directions.
    -->
    <origin rpy="0 0 0" xyz="0 0 ${ground_clearance}"/>
  </joint>

  <link name="${robot_prefix}chassis_link">
    <xacro:if value="${body_use_visual}">
      <xacro:visual_mesh mesh="${chassis_visual_mesh}" scale="${body_mesh_scale}"/>
    </xacro:if>

    <xacro:if value="${body_use_collision}">
      <xacro:collision_mesh mesh="${chassis_collision_mesh}" scale="${body_mesh_scale}"/>
    </xacro:if>

    <xacro:if value="${body_use_inertial}">
      <xacro:solid_box_inertia mass="${top_body_mass}"
                               size="${top_body_size_x} ${top_body_size_y} ${top_body_size_z}"
                               origin="0 0 0.10 0 0 0"/>
    </xacro:if>

    <xacro:unless value="${body_use_inertial}">
      <xacro:null_inertia/>
    </xacro:unless>
  </link>

  <joint name="${robot_prefix}chassis_joint" type="fixed">
    <parent link="${robot_prefix}${base_name}_link"/>
    <child link="${robot_prefix}chassis_link"/>
    <!--
    RB-VOGUI places 'chassis_link' slightly forward of 'base_link' and above the wheel center.
    The copied chassis meshes already contain their own Z extent, so the link origin matches the
    mesh origin.
    -->
    <xacro:origin_element origin="${chassis_joint_origin}"/>
  </joint>

  <!--
  The battery link follows RB-VOGUI and is mounted from 'chassis_link', not directly from
  'base_link'. The battery STL extends below its own link origin.
  -->
  <link name="${robot_prefix}battery_link">
    <xacro:if value="${body_use_visual}">
      <xacro:visual_mesh mesh="${battery_mesh}"
                         scale="${body_mesh_scale}"
                         color="${battery_color}"/>
    </xacro:if>

    <xacro:if value="${body_use_collision}">
      <xacro:collision_mesh mesh="${battery_mesh}" scale="${body_mesh_scale}"/>
    </xacro:if>

    <xacro:if value="${body_use_inertial}">
      <xacro:solid_box_inertia mass="${bottom_body_mass}"
        size="${bottom_body_size_x} ${bottom_body_size_y} ${bottom_body_size_z}"
        origin="0 0 -0.05 0 0 0"/>
    </xacro:if>

    <xacro:unless value="${body_use_inertial}">
      <xacro:null_inertia/>
    </xacro:unless>
  </link>

  <joint name="${robot_prefix}battery_joint" type="fixed">
    <parent link="${robot_prefix}chassis_link"/>
    <child link="${robot_prefix}battery_link"/>
    <xacro:origin_element origin="${battery_joint_origin}"/>
  </joint>

  <!--
  Definition of the steerable wheels.
  -->

  <!-- RB-VOGUI places wheel steering frames at the same height as base_link. -->
  <xacro:property name="z_s_wheel" value="0.0"/>
  <xacro:property name="d"         value="${float(dist_to_wheels)}"/>
  <xacro:property name="alpha"     value="${radians(float(alpha_deg))}"/>
  <xacro:property name="x_0"       value="${d * cos(alpha)}"/>
  <xacro:property name="y_0"       value="${d * sin(alpha)}"/>

  <!--
  The steerable_wheel macro creates:
  - Links:
    * ${prefix}${name}_steerable_link
    * ${prefix}${name}_rotation_link
  - Joints:
    * ${prefix}${name}_steering_joint (revolute|fixed):
      parent=${parent_frame}, child=${prefix}${name}_steerable_link
    * ${prefix}${name}_rotation_joint (continuous|fixed):
      parent=${prefix}${name}_steerable_link, child=${prefix}${name}_rotation_link
  -->

  <!-- Front left wheel: (x_0, y_0) -->
  <xacro:property name="front_left_wheel_sim_cfg"
                  value="${sim_cfg.get('front_left_wheel', dict())}"/>
  <xacro:set_props_wheel_sim prop_prefix="front_left_wheel_sim"
                             sim_cfg="${front_left_wheel_sim_cfg}"/>
  <xacro:steerable_wheel
    name="${front_left_wheel_name}"
    prefix="${robot_prefix}"
    parent_frame="${robot_prefix}${base_name}_link"
    use_visual="${s_wheel_use_visual}"
    use_inertial="${s_wheel_use_inertial}"
    v_mesh="${s_wheel_mesh}"
    v_mesh_scale="${s_wheel_mesh_scale}"
    color="${s_wheel_color}"
    radius="${s_wheel_radius}"
    length="${s_wheel_thickness}"
    mass="${s_wheel_mass}"
    steering_joint_type="${s_wheel_steering_joint_type}"
    steering_joint_limits="${s_wheel_steering_joint_limits}"
    rotation_joint_type="${s_wheel_rotation_joint_type}"
    rotation_joint_limits="${s_wheel_rotation_joint_limits}"
    sim_enabled="${front_left_wheel_sim_enabled}"
    sim_max_contacts="${front_left_wheel_sim_max_contacts}"
    sim_mu="${front_left_wheel_sim_mu}"
    sim_mu2="${front_left_wheel_sim_mu2}"
    sim_slip1="${front_left_wheel_sim_slip1}"
    sim_slip2="${front_left_wheel_sim_slip2}"
    joint_parent_fr_wheel_fr="${x_0} ${y_0} ${z_s_wheel} 0.0 0.0 0.0"/>

  <!-- Front right wheel: (x_0, -y_0) -->
  <xacro:property name="front_right_wheel_sim_cfg"
                  value="${sim_cfg.get('front_right_wheel', dict())}"/>
  <xacro:set_props_wheel_sim prop_prefix="front_right_wheel_sim"
                             sim_cfg="${front_right_wheel_sim_cfg}"/>
  <xacro:steerable_wheel
    name="${front_right_wheel_name}"
    prefix="${robot_prefix}"
    parent_frame="${robot_prefix}${base_name}_link"
    use_visual="${s_wheel_use_visual}"
    use_inertial="${s_wheel_use_inertial}"
    v_mesh="${s_wheel_mesh}"
    v_mesh_scale="${s_wheel_mesh_scale}"
    color="${s_wheel_color}"
    radius="${s_wheel_radius}"
    length="${s_wheel_thickness}"
    mass="${s_wheel_mass}"
    steering_joint_type="${s_wheel_steering_joint_type}"
    steering_joint_limits="${s_wheel_steering_joint_limits}"
    rotation_joint_type="${s_wheel_rotation_joint_type}"
    rotation_joint_limits="${s_wheel_rotation_joint_limits}"
    sim_enabled="${front_right_wheel_sim_enabled}"
    sim_max_contacts="${front_right_wheel_sim_max_contacts}"
    sim_mu="${front_right_wheel_sim_mu}"
    sim_mu2="${front_right_wheel_sim_mu2}"
    sim_slip1="${front_right_wheel_sim_slip1}"
    sim_slip2="${front_right_wheel_sim_slip2}"
    joint_parent_fr_wheel_fr="${x_0} ${-y_0} ${z_s_wheel} 0.0 0.0 0.0"/>

  <!-- Rear left wheel: (-x_0, y_0) -->
  <xacro:property name="rear_left_wheel_sim_cfg"
                  value="${sim_cfg.get('rear_left_wheel', dict())}"/>
  <xacro:set_props_wheel_sim prop_prefix="rear_left_wheel_sim"
                             sim_cfg="${rear_left_wheel_sim_cfg}"/>
  <xacro:steerable_wheel
    name="${rear_left_wheel_name}"
    prefix="${robot_prefix}"
    parent_frame="${robot_prefix}${base_name}_link"
    use_visual="${s_wheel_use_visual}"
    use_inertial="${s_wheel_use_inertial}"
    v_mesh="${s_wheel_mesh}"
    v_mesh_scale="${s_wheel_mesh_scale}"
    color="${s_wheel_color}"
    radius="${s_wheel_radius}"
    length="${s_wheel_thickness}"
    mass="${s_wheel_mass}"
    steering_joint_type="${s_wheel_steering_joint_type}"
    steering_joint_limits="${s_wheel_steering_joint_limits}"
    rotation_joint_type="${s_wheel_rotation_joint_type}"
    rotation_joint_limits="${s_wheel_rotation_joint_limits}"
    sim_enabled="${rear_left_wheel_sim_enabled}"
    sim_max_contacts="${rear_left_wheel_sim_max_contacts}"
    sim_mu="${rear_left_wheel_sim_mu}"
    sim_mu2="${rear_left_wheel_sim_mu2}"
    sim_slip1="${rear_left_wheel_sim_slip1}"
    sim_slip2="${rear_left_wheel_sim_slip2}"
    joint_parent_fr_wheel_fr="${-x_0} ${y_0} ${z_s_wheel} 0.0 0.0 0.0"/>

  <!-- Rear right wheel: (-x_0, -y_0) -->
  <xacro:property name="rear_right_wheel_sim_cfg"
                  value="${sim_cfg.get('rear_right_wheel', dict())}"/>
  <xacro:set_props_wheel_sim prop_prefix="rear_right_wheel_sim"
                             sim_cfg="${rear_right_wheel_sim_cfg}"/>
  <xacro:steerable_wheel
    name="${rear_right_wheel_name}"
    prefix="${robot_prefix}"
    parent_frame="${robot_prefix}${base_name}_link"
    use_visual="${s_wheel_use_visual}"
    use_inertial="${s_wheel_use_inertial}"
    v_mesh="${s_wheel_mesh}"
    v_mesh_scale="${s_wheel_mesh_scale}"
    color="${s_wheel_color}"
    radius="${s_wheel_radius}"
    length="${s_wheel_thickness}"
    mass="${s_wheel_mass}"
    steering_joint_type="${s_wheel_steering_joint_type}"
    steering_joint_limits="${s_wheel_steering_joint_limits}"
    rotation_joint_type="${s_wheel_rotation_joint_type}"
    rotation_joint_limits="${s_wheel_rotation_joint_limits}"
    sim_enabled="${rear_right_wheel_sim_enabled}"
    sim_max_contacts="${rear_right_wheel_sim_max_contacts}"
    sim_mu="${rear_right_wheel_sim_mu}"
    sim_mu2="${rear_right_wheel_sim_mu2}"
    sim_slip1="${rear_right_wheel_sim_slip1}"
    sim_slip2="${rear_right_wheel_sim_slip2}"
    joint_parent_fr_wheel_fr="${-x_0} ${-y_0} ${z_s_wheel} 0.0 0.0 0.0"/>

  <!-- ===================================================================== -->
  <!-- PLUGINS FOR THE BASE -->
  <!-- ===================================================================== -->

  <xacro:if value="${sim_file != ''}">
    <gazebo>
      <!--
      To find the reference for the system Gazebo plugins:
      1. Go to: https://gazebosim.org/libs/
      2. Click in the link 'API & Tutorials' for the 'Sim' section.
      3. Click in the link 'gz::sim::systems'

      At the time of writing this text (March 2026), the link 'gz::sim::systems' points to the
      URL 'https://gazebosim.org/api/sim/10/namespacegz_1_1sim_1_1systems.html', for API reference
      10.1.1
      -->

      <!--
      Insert the `VelocityControl` Gazebo plugin to control robot motion by applying the twist
      received from its subscribed topic.
      The twist is applied directly to the robot's model in Gazebo without simulating forces on the
      wheels or the ground.
      This provides stable velocity control without tuning friction parameters or modelling wheel
      slip.
      -->
      <xacro:property name="base_velocity_controller_sim_cfg"
        value="${sim_cfg.get('base_velocity_controller', dict())}"/>

      <xacro:if value="${base_velocity_controller_sim_cfg.get('enabled', False)}">
        <!--
        Prepend the prefix `bvc_` to all properties related to the (b)ase (v)elocity
        (c)ontroller Gazebo plugin, to avoid name conflicts with other Gazebo plugins.
        -->
        <xacro:property name="bvc_topic" value="${base_velocity_controller_sim_cfg.get('topic', '')}"/>

        <xacro:if value="${bvc_topic == ''}">
          ${xacro.fatal(
            "base_velocity_controller.topic is required when base_velocity_controller.enabled is true.")}
        </xacro:if>

        <xacro:if value="${bvc_topic != ''}">
          <xacro:resolve_topic prop_id="bvc_resolved_topic"
            topic="${bvc_topic}"
            namespace="${robot_namespace}"/>

          <xacro:property name="bvc_initial_linear_vel"
            value="${base_velocity_controller_sim_cfg.get('initial_linear_vel', dict(x=0, y=0, z=0))}"/>

          <xacro:property name="bvc_initial_angular_vel"
            value="${base_velocity_controller_sim_cfg.get('initial_angular_vel', dict(x=0, y=0, z=0))}"/>

          <xacro:plugin_velocity_control
            topic="${bvc_resolved_topic}"
            initial_linear="${bvc_initial_linear_vel['x']} ${bvc_initial_linear_vel['y']} ${bvc_initial_linear_vel['z']}"
            initial_angular="${bvc_initial_angular_vel['x']} ${bvc_initial_angular_vel['y']} ${bvc_initial_angular_vel['z']}"/>
        </xacro:if>
      </xacro:if>

      <!--
      Publish the pose of the robot base with respect to a configured reference frame.
      More details are available in
      package://robotics_description/urdf/gz_system_plugins/plugin_pose_publisher_in_reference_frame_macro.xacro.
      -->
      <xacro:property name="pose_publisher_sim_cfg"
                      value="${sim_cfg.get('pose_publisher', dict())}"/>

      <xacro:if value="${pose_publisher_sim_cfg.get('enabled', False)}">
        <xacro:property name="pose_pub_topic"
                        value="${pose_publisher_sim_cfg.get('topic', '') or ''}"/>
        <xacro:property name="pose_pub_topic_with_covariance"
                        value="${pose_publisher_sim_cfg.get('topic_with_covariance', '') or ''}"/>
        <xacro:property name="pose_pub_tf_topic"
                        value="${pose_publisher_sim_cfg.get('tf_topic', '') or ''}"/>

        <xacro:if value="${pose_pub_topic == '' and pose_pub_topic_with_covariance == '' and pose_pub_tf_topic == ''}">
          ${xacro.fatal("pose_publisher requires at least one output topic when pose_publisher.enabled is true.")}
        </xacro:if>

        <xacro:if value="${pose_pub_topic != '' or pose_pub_topic_with_covariance != '' or pose_pub_tf_topic != ''}">
          <xacro:if value="${pose_pub_topic != ''}">
            <xacro:resolve_topic prop_id="pose_pub_resolved_topic"
                                 topic="${pose_pub_topic}"
                                 namespace="${robot_namespace}"/>
          </xacro:if>
          <xacro:if value="${pose_pub_topic == ''}">
            <xacro:property name="pose_pub_resolved_topic" value=""/>
          </xacro:if>

          <xacro:if value="${pose_pub_topic_with_covariance != ''}">
            <xacro:resolve_topic prop_id="pose_pub_resolved_topic_with_covariance"
                                 topic="${pose_pub_topic_with_covariance}"
                                 namespace="${robot_namespace}"/>
          </xacro:if>
          <xacro:if value="${pose_pub_topic_with_covariance == ''}">
            <xacro:property name="pose_pub_resolved_topic_with_covariance" value=""/>
          </xacro:if>

          <xacro:if value="${pose_pub_tf_topic != ''}">
            <xacro:resolve_topic prop_id="pose_pub_resolved_tf_topic"
                                 topic="${pose_pub_tf_topic}"
                                 namespace="${robot_namespace}"/>
          </xacro:if>
          <xacro:if value="${pose_pub_tf_topic == ''}">
            <xacro:property name="pose_pub_resolved_tf_topic" value=""/>
          </xacro:if>

          <xacro:property name="pose_pub_reference_frame"
                          value="${pose_publisher_sim_cfg.get('reference_frame', '') or ''}"/>

          <xacro:if value="${pose_pub_reference_frame == ''}">
            ${xacro.fatal("pose_publisher.reference_frame is required when pose_publisher.enabled is true.")}
          </xacro:if>

          <xacro:property name="pose_pub_local_offset"
                          value="${pose_publisher_sim_cfg.get(
                            'local_offset', dict(x=0, y=0, z=0, R=0, P=0, Y=0))}"/>
          <xacro:property name="pose_pub_global_offset"
                          value="${pose_publisher_sim_cfg.get(
                            'global_offset', dict(x=0, y=0, z=0, R=0, P=0, Y=0))}"/>
          <xacro:property name="pose_pub_gaussian_noise"
                          value="${pose_publisher_sim_cfg.get('gaussian_noise', 0)}"/>
          <xacro:property name="pose_pub_msg_publication_freq"
                          value="${pose_publisher_sim_cfg.get('msg_publication_freq', 50)}"/>

          <xacro:plugin_pose_publisher_in_reference_frame
            reference_frame="${pose_pub_reference_frame}"
            robot_frame="${robot_prefix}${base_name}_footprint_link"
            msg_publication_freq="${pose_pub_msg_publication_freq}"
            topic="${pose_pub_resolved_topic}"
            topic_with_covariance="${pose_pub_resolved_topic_with_covariance}"
            tf_topic="${pose_pub_resolved_tf_topic}"
            dimensions="2"
            xyz_offset="${pose_pub_local_offset['x']} ${pose_pub_local_offset['y']} ${pose_pub_local_offset['z']}"
            rpy_offset="${pose_pub_local_offset['R']} ${pose_pub_local_offset['P']} ${pose_pub_local_offset['Y']}"
            xyz_global_offset="${pose_pub_global_offset['x']} ${pose_pub_global_offset['y']} ${pose_pub_global_offset['z']}"
            rpy_global_offset="${pose_pub_global_offset['R']} ${pose_pub_global_offset['P']} ${pose_pub_global_offset['Y']}"
            gaussian_noise="${pose_pub_gaussian_noise}"/>
        </xacro:if>
      </xacro:if>

      <!--
      Insert 4 `JointPositionController` Gazebo plugins, each one to control the steering joint of
      one steerable wheel.
      In this case, actuator messages (actuator_msgs/msg/Actuators) are used to transport the
      position of the steering joints.
      Velocity commands, derived from the positions, are used to control the steering joints,
      instead of using PIDs.
      By using velocity commands, bypassing the PIDs, we can achieve a perfect position for the
      steering joints.

      'sj' -> steering joint.
      -->

      <!--
      `JointPositionController` Gazebo plugin for the front-left steering joint.
       -->

      <xacro:property name="front_left_wheel_steering_controller_sim_cfg"
        value="${sim_cfg.get('front_left_wheel_steering_joint_controller', dict())}"/>

      <xacro:if value="${front_left_wheel_steering_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="front_left_wheel_steering_topic"
          value="${front_left_wheel_steering_controller_sim_cfg.get('topic', '')}"/>

        <xacro:if value="${front_left_wheel_steering_topic == ''}">
          ${xacro.fatal("front_left_wheel_steering_joint_controller.topic is required when the controller is enabled.")}
        </xacro:if>

        <xacro:if value="${front_left_wheel_steering_topic != ''}">
          <xacro:plugin_swheel_steering_joint_am_pos_velcmd
            joint_name="${robot_prefix}${front_left_wheel_name}_steering_joint"
            joint_limits="${s_wheel_steering_joint_limits}"
            initial_position="${front_left_wheel_steering_controller_sim_cfg.get('initial_angle', '')}"
            namespace="${robot_namespace}"
            topic="${front_left_wheel_steering_topic}"
            actuator_number="0"/>
        </xacro:if>
      </xacro:if>

      <!--
      `JointPositionController` Gazebo plugin for the front-right steering joint.
       -->

      <xacro:property name="front_right_wheel_steering_controller_sim_cfg"
        value="${sim_cfg.get('front_right_wheel_steering_joint_controller', dict())}"/>

      <xacro:if value="${front_right_wheel_steering_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="front_right_wheel_steering_topic"
          value="${front_right_wheel_steering_controller_sim_cfg.get('topic', '')}"/>

        <xacro:if value="${front_right_wheel_steering_topic == ''}">
          ${xacro.fatal("front_right_wheel_steering_joint_controller.topic is required when the controller is enabled.")}
        </xacro:if>

        <xacro:if value="${front_right_wheel_steering_topic != ''}">
          <xacro:plugin_swheel_steering_joint_am_pos_velcmd
            joint_name="${robot_prefix}${front_right_wheel_name}_steering_joint"
            joint_limits="${s_wheel_steering_joint_limits}"
            initial_position="${front_right_wheel_steering_controller_sim_cfg.get('initial_angle', '')}"
            namespace="${robot_namespace}"
            topic="${front_right_wheel_steering_topic}"
            actuator_number="1"/>
        </xacro:if>
      </xacro:if>

      <!--
      `JointPositionController` Gazebo plugin for the rear-left steering joint.
       -->

      <xacro:property name="rear_left_wheel_steering_controller_sim_cfg"
        value="${sim_cfg.get('rear_left_wheel_steering_joint_controller', dict())}"/>

      <xacro:if value="${rear_left_wheel_steering_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="rear_left_wheel_steering_topic"
          value="${rear_left_wheel_steering_controller_sim_cfg.get('topic', '')}"/>

        <xacro:if value="${rear_left_wheel_steering_topic == ''}">
          ${xacro.fatal("rear_left_wheel_steering_joint_controller.topic is required when the controller is enabled.")}
        </xacro:if>

        <xacro:if value="${rear_left_wheel_steering_topic != ''}">
          <xacro:plugin_swheel_steering_joint_am_pos_velcmd
            joint_name="${robot_prefix}${rear_left_wheel_name}_steering_joint"
            joint_limits="${s_wheel_steering_joint_limits}"
            initial_position="${rear_left_wheel_steering_controller_sim_cfg.get('initial_angle', '')}"
            namespace="${robot_namespace}"
            topic="${rear_left_wheel_steering_topic}"
            actuator_number="2"/>
        </xacro:if>
      </xacro:if>

      <!--
      `JointPositionController` Gazebo plugin for the rear-right steering joint.
       -->

      <xacro:property name="rear_right_wheel_steering_controller_sim_cfg"
        value="${sim_cfg.get('rear_right_wheel_steering_joint_controller', dict())}"/>

      <xacro:if value="${rear_right_wheel_steering_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="rear_right_wheel_steering_topic"
          value="${rear_right_wheel_steering_controller_sim_cfg.get('topic', '')}"/>

        <xacro:if value="${rear_right_wheel_steering_topic == ''}">
          ${xacro.fatal("rear_right_wheel_steering_joint_controller.topic is required when the controller is enabled.")}
        </xacro:if>

        <xacro:if value="${rear_right_wheel_steering_topic != ''}">
          <xacro:plugin_swheel_steering_joint_am_pos_velcmd
            joint_name="${robot_prefix}${rear_right_wheel_name}_steering_joint"
            joint_limits="${s_wheel_steering_joint_limits}"
            initial_position="${rear_right_wheel_steering_controller_sim_cfg.get('initial_angle', '')}"
            namespace="${robot_namespace}"
            topic="${rear_right_wheel_steering_topic}"
            actuator_number="3"/>
        </xacro:if>
      </xacro:if>

      <!--
      Insert 4 `JointController` Gazebo plugins, each one to control the rotation joint of one
      steerable wheel.
      In this case, actuator messages (actuator_msgs/msg/Actuators) are used to transport the
      velocity of the rotation joints.
      Pure velocity commands control the rotation joints instead of deriving forces through PIDs.

      'rj' -> rotation joint.
      -->

      <!--
      `JointController` Gazebo plugin for the front-left rotation joint.
       -->
      <xacro:property name="front_left_wheel_rotation_controller_sim_cfg"
        value="${sim_cfg.get('front_left_wheel_rotation_joint_controller', dict())}"/>

      <xacro:if value="${front_left_wheel_rotation_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="front_left_wheel_rotation_topic"
          value="${front_left_wheel_rotation_controller_sim_cfg.get('topic', '')}"/>

        <xacro:if value="${front_left_wheel_rotation_topic == ''}">
          ${xacro.fatal("front_left_wheel_rotation_joint_controller.topic is required when the controller is enabled.")}
        </xacro:if>

        <xacro:if value="${front_left_wheel_rotation_topic != ''}">
          <xacro:plugin_wheel_rotation_joint_am_vel
            joint_name="${robot_prefix}${front_left_wheel_name}_rotation_joint"
            joint_limits="${s_wheel_rotation_joint_limits}"
            initial_velocity="0.0"
            namespace="${robot_namespace}"
            topic="${front_left_wheel_rotation_topic}"
            actuator_number="0"/>
        </xacro:if>
      </xacro:if>

      <!--
      `JointController` Gazebo plugin for the front-right rotation joint.
       -->
      <xacro:property name="front_right_wheel_rotation_controller_sim_cfg"
        value="${sim_cfg.get('front_right_wheel_rotation_joint_controller', dict())}"/>

      <xacro:if value="${front_right_wheel_rotation_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="front_right_wheel_rotation_topic"
          value="${front_right_wheel_rotation_controller_sim_cfg.get('topic', '')}"/>

        <xacro:if value="${front_right_wheel_rotation_topic == ''}">
          ${xacro.fatal("front_right_wheel_rotation_joint_controller.topic is required when the controller is enabled.")}
        </xacro:if>

        <xacro:if value="${front_right_wheel_rotation_topic != ''}">
          <xacro:plugin_wheel_rotation_joint_am_vel
            joint_name="${robot_prefix}${front_right_wheel_name}_rotation_joint"
            joint_limits="${s_wheel_rotation_joint_limits}"
            initial_velocity="0.0"
            namespace="${robot_namespace}"
            topic="${front_right_wheel_rotation_topic}"
            actuator_number="1"/>
        </xacro:if>
      </xacro:if>

      <!--
      `JointController` Gazebo plugin for the rear-left rotation joint.
       -->
      <xacro:property name="rear_left_wheel_rotation_controller_sim_cfg"
        value="${sim_cfg.get('rear_left_wheel_rotation_joint_controller', dict())}"/>

      <xacro:if value="${rear_left_wheel_rotation_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="rear_left_wheel_rotation_topic"
          value="${rear_left_wheel_rotation_controller_sim_cfg.get('topic', '')}"/>

        <xacro:if value="${rear_left_wheel_rotation_topic == ''}">
          ${xacro.fatal("rear_left_wheel_rotation_joint_controller.topic is required when the controller is enabled.")}
        </xacro:if>

        <xacro:if value="${rear_left_wheel_rotation_topic != ''}">
          <xacro:plugin_wheel_rotation_joint_am_vel
            joint_name="${robot_prefix}${rear_left_wheel_name}_rotation_joint"
            joint_limits="${s_wheel_rotation_joint_limits}"
            initial_velocity="0.0"
            namespace="${robot_namespace}"
            topic="${rear_left_wheel_rotation_topic}"
            actuator_number="2"/>
        </xacro:if>
      </xacro:if>

      <!--
      `JointController` Gazebo plugin for the rear-right rotation joint.
       -->
      <xacro:property name="rear_right_wheel_rotation_controller_sim_cfg"
        value="${sim_cfg.get('rear_right_wheel_rotation_joint_controller', dict())}"/>

      <xacro:if value="${rear_right_wheel_rotation_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="rear_right_wheel_rotation_topic"
          value="${rear_right_wheel_rotation_controller_sim_cfg.get('topic', '')}"/>

        <xacro:if value="${rear_right_wheel_rotation_topic == ''}">
          ${xacro.fatal("rear_right_wheel_rotation_joint_controller.topic is required when the controller is enabled.")}
        </xacro:if>

        <xacro:if value="${rear_right_wheel_rotation_topic != ''}">
          <xacro:plugin_wheel_rotation_joint_am_vel
            joint_name="${robot_prefix}${rear_right_wheel_name}_rotation_joint"
            joint_limits="${s_wheel_rotation_joint_limits}"
            initial_velocity="0.0"
            namespace="${robot_namespace}"
            topic="${rear_right_wheel_rotation_topic}"
            actuator_number="3"/>
        </xacro:if>
      </xacro:if>
    </gazebo>
  </xacro:if>
</robot>
